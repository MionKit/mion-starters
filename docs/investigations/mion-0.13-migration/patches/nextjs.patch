diff -ruN a/nextjs/16/app/mion-server/server-client.ts b/nextjs/16/app/mion-server/server-client.ts
--- a/nextjs/16/app/mion-server/server-client.ts
+++ b/nextjs/16/app/mion-server/server-client.ts
@@ -0,0 +1,24 @@
+import 'server-only';
+import {headers} from 'next/headers';
+import {initClient} from '@mionjs/client';
+import type {MyApi} from '@mion-app/api';
+
+/** mion client for Server Components: calls this app's own route handler over HTTP.
+ *  Returns the client object, never `routes` itself: the routes proxy answers `then`, so awaiting it hangs forever */
+async function serverClient() {
+    const h = await headers();
+    const origin = `${h.get('x-forwarded-proto') ?? 'http'}://${h.get('host')}`;
+    return initClient<MyApi>({baseURL: origin, basePath: 'api/mion'});
+}
+
+export async function helloFromServer(name: string) {
+    const {routes} = await serverClient();
+    const [greeting, error] = await routes.hello(name).call();
+    return error ? `error: ${error.publicMessage}` : greeting;
+}
+
+export async function timeFromServer() {
+    const {routes} = await serverClient();
+    const [time] = await routes.getTime().call();
+    return time;
+}
