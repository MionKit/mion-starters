+import type {NextConfig} from 'next';
+import {mkdirSync} from 'node:fs';
+import {withMion} from '@mionjs/devtools/next';
+
+// `satisfies` (not `: NextConfig`): withMion takes Record<string, unknown>, which the NextConfig interface is not
+const nextConfig = {
+    turbopack: {root: import.meta.dirname},
+    // one instance of mion's runtime per server process (no "@mionjs/core has been loaded N times" warning)
+    serverExternalPackages: ['@mionjs/core', '@mionjs/router', '@mionjs/run-types', '@mionjs/client', '@mionjs/platform-vercel'],
+} satisfies NextConfig;
+
+// WORKAROUND (Next 16.4): withMion returns before its scan creates .mion/, and a Turbopack build that starts without
+// the folder never sees the generated modules ("Can't resolve '.mion/types/…'") on a clean checkout.
+mkdirSync(new URL('./.mion', import.meta.url), {recursive: true});
+
+// WORKAROUND: `next dev --webpack` evaluates this file in a forked child whose argv has no `--webpack` and whose env has
+// no TURBOPACK, so withMion's isTurbopack() guesses Turbopack and the webpack build gets no mion transform at all.
+// Next 16 always sets TURBOPACK ('auto' | '1') when Turbopack runs, so its absence means webpack.
+if (!process.env.TURBOPACK && !process.argv.includes('--webpack')) process.argv.push('--webpack');
+
+// await is required by withMion's contract (it starts the type scan for Turbopack's loader)
+export default await withMion(nextConfig);
