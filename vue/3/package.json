{
  "name": "@mionjs/create-starter-vue",
  "version": "0.3.0",
  "description": "Starter template for building full-stack apps with mion + Vue 3 (SPA). Run `npm create @mionjs/starter-vue <project-name>` to scaffold.",
  "type": "module",
  "license": "MIT",
  "author": "mion",
  "homepage": "https://mion.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/mion-starters.git",
    "directory": "vue/3"
  },
  "bugs": {
    "url": "https://github.com/MionKit/mion-starters/issues"
  },
  "keywords": [
    "mion",
    "mionjs",
    "vue",
    "vue3",
    "vite",
    "starter",
    "template",
    "create",
    "rpc",
    "api",
    "typescript",
    "spa"
  ],
  "bin": {
    "create-starter-vue": "create.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:bun": "vite build --mode bun",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview": "vite preview",
    "preview:api": "node dist-server/server.node.js",
    "preview:bun": "bun dist-server/server.bun.js",
    "preview:cloudflare": "wrangler dev",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@mionjs/client": "0.13.2",
    "@mionjs/core": "0.13.2",
    "@mionjs/platform-bun": "0.13.2",
    "@mionjs/platform-cloudflare": "0.13.2",
    "@mionjs/platform-node": "0.13.2",
    "@mionjs/router": "0.13.2",
    "@mionjs/run-types": "0.13.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "0.13.2",
    "@mionjs/devtools": "0.13.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxlint": "^1.89.0",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0"
  }
}
