{
  "name": "@mionjs/create-starter-react",
  "version": "0.4.0",
  "description": "Starter template for building full-stack apps with mion + React 19 (SPA). Run `npm create @mionjs/starter-react <project-name>` to scaffold.",
  "type": "module",
  "license": "MIT",
  "author": "mion",
  "homepage": "https://mion.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MionKit/mion-starters.git",
    "directory": "react/19"
  },
  "bugs": {
    "url": "https://github.com/MionKit/mion-starters/issues"
  },
  "keywords": [
    "mion",
    "mionjs",
    "react",
    "react19",
    "vite",
    "starter",
    "template",
    "create",
    "rpc",
    "api",
    "typescript",
    "spa"
  ],
  "bin": {
    "create-starter-react": "create.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:api": "node dist-server/server.node.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@mionjs/client": "0.14.0",
    "@mionjs/core": "0.14.0",
    "@mionjs/platform-node": "0.14.0",
    "@mionjs/router": "0.14.0",
    "@mionjs/run-types": "0.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "0.14.0",
    "@mionjs/devtools": "0.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
