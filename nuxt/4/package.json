{
  "name": "@mionjs/create-starter-nuxt",
  "version": "0.3.0",
  "description": "Starter template for building full-stack apps with mion + Nuxt 4 (SPA). Run `npm create @mionjs/starter-nuxt <project-name>` to scaffold.",
  "type": "module",
  "license": "MIT",
  "author": "mion",
  "homepage": "https://mion.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mionjs/mion-starters.git",
    "directory": "nuxt/4"
  },
  "bugs": {
    "url": "https://github.com/mionjs/mion-starters/issues"
  },
  "keywords": [
    "mion",
    "mionjs",
    "nuxt",
    "starter",
    "template",
    "create",
    "rpc",
    "api",
    "typescript",
    "vue",
    "spa"
  ],
  "bin": {
    "create-starter-nuxt": "create.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && npm run build:api",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "build:api": "vite build --config api/vite.config.ts --mode server.node",
    "build:api:bun": "vite build --config api/vite.config.ts --mode server.bun",
    "build:api:cloudflare": "vite build --config api/vite.config.ts --mode cloudflare-worker",
    "preview:api": "node api/dist/server.node.js",
    "preview:api:bun": "bun api/dist/server.bun.js",
    "preview:api:cloudflare": "npx wrangler@4 dev --config deploy/wrangler.toml --port 3001",
    "typecheck": "nuxi typecheck && tsc -p api",
    "lint": "eslint",
    "test:unit": "vitest run --config api/vite.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:build": "playwright test -c playwright.prod.config.ts",
    "test": "npm run test:unit && playwright test",
    "test:install": "playwright install chromium",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@mionjs/client": "0.13.2",
    "@mionjs/core": "0.13.2",
    "@mionjs/platform-bun": "0.13.2",
    "@mionjs/platform-cloudflare": "0.13.2",
    "@mionjs/platform-node": "0.13.2",
    "@mionjs/router": "0.13.2",
    "@mionjs/run-types": "0.13.2",
    "@nuxt/eslint": "^1.17.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "0.13.2",
    "@mionjs/devtools": "0.13.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
